# Copy to .env for local Docker Compose use. Never commit the populated file.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OPENAI_API_KEY=

# Optional model and tracing overrides
OLLAMA_TEMPERATURE=0.7
OLLAMA_MODEL_CLASSIFY=gemma4:31b
OLLAMA_MODEL_SENTIMENT=glm-5.2
OLLAMA_MODEL_SUMMARIZE=mistral-large-3:675b
OLLAMA_MODEL_INTENT=minimax-m3
OTEL_SDK_DISABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
